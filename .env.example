# MI/CAD SNP-gene-pathway — environment variables
# Copy to .env and adjust. Never commit real secrets.
# Backend is fail-closed: MODEL_RELEASE_APPROVED and APPROVED_ARTIFACT_REVISION must both be set for rankings.

# Release gate — must be "true" (case-insensitive: true/1/yes) to load model artifacts. Default false (safe).
MODEL_RELEASE_APPROVED=false
# Non-empty revision string required when gate is approved. Example: v1, 2026-01-train. Must match artifact revision.
APPROVED_ARTIFACT_REVISION=
# Directory containing model artifacts (rankings.json, features.json, evaluation.json, optionally pathways.json). Default ./artifacts.
ARTIFACT_DIR=./artifacts

# Auth — path to Firebase service account JSON for Bearer JWT verification (optional, dev default off).
FIREBASE_SERVICE_ACCOUNT_JSON=
# If true, all /rankings, /genes/*, /explain/* require valid Bearer JWT. Default false (allows unauthenticated in dev).
REQUIRE_AUTH=false

# Frontend — base URL for backend API consumed by Vite. Empty means same-origin / relative (proxied in dev).
VITE_API_URL=http://localhost:8000
